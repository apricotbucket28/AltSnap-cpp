<?xml version="1.0" encoding="utf-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Auto" OpenPaneLength="244" AlwaysShowHeader="False" IsPaneToggleButtonVisible="True">
    <NavigationView.PaneHeader>
      <StackPanel Margin="16,12,16,20" Spacing="4">
        <TextBlock Text="AltSnap" Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock Text="Make your windows move." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </NavigationView.PaneHeader>
    <NavigationView.MenuItems>
      <NavigationViewItem Content="General" Tag="General" Icon="Home" />
      <NavigationViewItem Content="Snapping" Tag="Snapping" Icon="DockLeft" />
      <NavigationViewItem Content="Appearance" Tag="Appearance" Icon="Setting" />
      <NavigationViewItem Content="About" Tag="About" Icon="Help" />
    </NavigationView.MenuItems>
    <NavigationView.PaneFooter>
      <StackPanel Margin="16" Spacing="6">
        <TextBlock Text="SETTINGS PREVIEW" Style="{ThemeResource CaptionTextBlockStyle}" />
        <TextBlock Text="Your familiar tools are still available in legacy settings." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </NavigationView.PaneFooter>
    <Grid Padding="32,28,32,24" RowSpacing="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="8">
        <TextBlock x:Name="DraftStatus" Text="Connecting…" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Severity="Informational" Title="Connecting to AltSnap" Message="Reading settings from the resident host." />
      </StackPanel>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Spacing="24">
          <StackPanel x:Name="GeneralPage" Spacing="20">
            <StackPanel Spacing="8">
              <TextBlock Text="General" Style="{ThemeResource TitleTextBlockStyle}" />
              <TextBlock Text="A little less friction. A little more control." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
              <StackPanel Spacing="16">
                <TextBlock Text="Window behavior" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="AutoFocus" Header="Focus windows when dragging" OffContent="Off" OnContent="On" IsEnabled="False" />
                <TextBlock Text="Bring a window to the foreground when you drag it with AltSnap. You can also press Ctrl while dragging to focus a window." TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
              <StackPanel Spacing="12">
                <TextBlock Text="Everything else, right where you left it" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Mouse mappings, keyboard shortcuts, exclusions, zones, and advanced options are available in the legacy settings window." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="Legacy" Content="Open legacy settings" IsEnabled="False" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SnappingPage" Visibility="Collapsed" Spacing="20">
            <StackPanel Spacing="8">
              <TextBlock Text="Snapping" Style="{ThemeResource TitleTextBlockStyle}" />
              <TextBlock Text="Arrange windows with less effort." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
              <StackPanel Spacing="16">
                <TextBlock Text="Screen edges and corners" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Spacing="6">
                  <ToggleSwitch x:Name="Aero" Header="Snap to screen edges" IsEnabled="False" OffContent="Off" OnContent="On" />
                  <TextBlock Text="Drag a window to an edge or corner with AltSnap to tile or maximize it. Hold Ctrl to keep the pointer on the current monitor." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
              <StackPanel Spacing="16">
                <TextBlock Text="Smarter window sizing" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Spacing="6">
                  <ToggleSwitch x:Name="SmartSizing" Header="Match neighboring snapped windows" IsEnabled="False" OffContent="Off" OnContent="On" />
                  <TextBlock Text="Adjust snap sizes to fit windows you have already arranged." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <ToggleSwitch x:Name="SmartCandidates" Header="Consider more neighboring windows" IsEnabled="False" OffContent="Off" OnContent="On" />
                  <TextBlock Text="Include windows arranged outside AltSnap when finding a matching size." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <ToggleSwitch x:Name="KeepSnapped" Header="Keep snapped window sizes" IsEnabled="False" OffContent="Off" OnContent="On" />
                  <TextBlock Text="Keep the snapped size when moving a window instead of restoring its previous size." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
              <StackPanel Spacing="16">
                <TextBlock Text="Moving and resizing" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Spacing="8">
                  <ComboBox x:Name="AutoSnap" Header="Automatically snap to" HorizontalAlignment="Stretch" IsEnabled="False">
                    <ComboBoxItem Content="Off" />
                    <ComboBoxItem Content="Screen edges and taskbar" />
                    <ComboBoxItem Content="Also outside edges of windows" />
                    <ComboBoxItem Content="Also inside edges of windows" />
                  </ComboBox>
                  <TextBlock Text="Choose which boundaries attract windows as you move or resize them. Shift temporarily changes snapping during a drag." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="8">
                  <ComboBox x:Name="StickyResize" Header="Resize neighboring windows together" HorizontalAlignment="Stretch" IsEnabled="False">
                    <ComboBoxItem Content="Off" />
                    <ComboBoxItem Content="While holding Shift" />
                    <ComboBoxItem Content="Unless holding Shift" />
                  </ComboBox>
                  <TextBlock Text="Resize windows that share an edge with the window you are resizing." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="Custom zone layouts and fine-tuning options remain available in legacy settings and the INI file." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <StackPanel x:Name="AppearancePage" Visibility="Collapsed" Spacing="20">
            <StackPanel Spacing="8">
              <TextBlock Text="Appearance" Style="{ThemeResource TitleTextBlockStyle}" />
              <TextBlock Text="Make this space feel like yours." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
              <StackPanel Spacing="16">
                <TextBlock Text="App theme" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="Theme" Header="Choose a theme for this window" SelectedIndex="0" MinWidth="240">
                  <ComboBoxItem Content="Use Windows setting" />
                  <ComboBoxItem Content="Light" />
                  <ComboBoxItem Content="Dark" />
                </ComboBox>
                <TextBlock Text="Windows contrast themes and text scaling are respected automatically. This preference applies to this session." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="AboutPage" Visibility="Collapsed" Spacing="20">
            <TextBlock Text="About AltSnap" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Move freely." FontSize="40" FontWeight="SemiBold" />
            <TextBlock Text="Simple window management, built around the way you work." TextWrapping="Wrap" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock Text="WinUI 3 settings preview" />
            <TextBlock Text="AltSnap by Raymond Gillibert, based on AltDrag by Stefan Sundin. Free software licensed under GNU GPL v3 or later." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ConfigPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="Reload" Content="Reload" ToolTipService.ToolTip="Read saved settings again. You will be asked before discarding changes." IsEnabled="False" />
          <Button x:Name="StartHost" Content="Start AltSnap" Visibility="Collapsed" />
          <Button x:Name="Cancel" Content="Cancel" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
          <Button x:Name="Apply" Content="Apply changes" IsEnabled="False" />
          <Button x:Name="Okay" Content="OK" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" />
        </StackPanel>
      </Grid>
    </Grid>
  </NavigationView>
</Grid>
