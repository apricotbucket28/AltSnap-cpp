<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <AltSnapRoot>$(MSBuildThisFileDirectory)..\..\</AltSnapRoot>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.26100.0</WindowsTargetPlatformMinVersion>
    <VCToolsVersion>14.50.35717</VCToolsVersion>
    <VCToolsRedistVersion>14.50.35710</VCToolsRedistVersion>
    <PlatformToolset>v145</PlatformToolset>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <PackagesRoot>$(AltSnapRoot)build\nuget\</PackagesRoot>
    <OutDir>$(AltSnapRoot)build\msvc\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(AltSnapRoot)build\obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
</Project>
