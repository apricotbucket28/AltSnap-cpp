    <!-- Unpackaged XAML resolves theme URIs through the application's merged PRI. -->
    <MakeDir Directories="$(IntDir)ResourceInput" />
    <ItemGroup>
      <RuntimePri Include="$(OutDir)Microsoft.UI.pri;$(OutDir)Microsoft.UI.Xaml.Controls.pri;$(OutDir)Microsoft.WindowsAppRuntime.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimePri)" DestinationFolder="$(IntDir)ResourceInput" />
    <Exec StandardOutputImportance="Low" Command="&quot;$(WindowsSdkDir)bin\$(WindowsTargetPlatformVersion)\x64\makepri.exe&quot; new /pr &quot;$(IntDir)ResourceInput&quot; /cf &quot;$(MSBuildThisFileDirectory)..\..\settings-priconfig.xml&quot; /of &quot;$(OutDir)resources.pri&quot; /o" />
    <!-- App-local CRT deployment; do not assume a developer-machine redist. -->
    <ItemGroup>
      <LocalCRT Include="$(VCInstallDir)Redist\MSVC\$(VCToolsRedistVersion)\x64\Microsoft.VC145.CRT\*.dll" />
    </ItemGroup>
    <Error Condition="'@(LocalCRT)' == ''" Text="The x64 VC145 CRT redistributable is required for app-local deployment." />
    <Copy SourceFiles="@(LocalCRT)" DestinationFolder="$(OutDir)" />
  </Target>
